{
  "name": "livescribe",
  "productName": "LiveScribe",
  "version": "0.1.0",
  "description": "Transkripsi audio sistem (loopback) secara hampir real-time untuk Windows.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "LiveScribe",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "bench:stt": "esbuild scripts/bench-stt.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/bench/bench-stt.mjs --alias:@shared=./src/shared --log-level=warning && node out/bench/bench-stt.mjs",
    "pin:whisper": "node scripts/pin-whisper.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
